# only what the Dockerfile COPYs is needed, keep the build context small
venv/
.venv/
.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.vscode/
.idea/

logs/
notebooks/

# DVC: cache and pipeline files are not needed to serve the model
.dvc/
.dvcignore
dvc.yaml
dvc.lock
params.yaml
metrics.json
catboost_info/
tests/
*.egg-info/

# secrets: injected as environment variables by the platform, never baked into the image
.env
.env.*

# local MLflow registry: stores absolute Windows paths, unusable inside the container
mlflow.db
mlruns/
mlartifacts/

Dockerfile
.dockerignore
